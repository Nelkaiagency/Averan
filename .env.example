# ============================================================
#  Averan website configuration
#  Set these in Vercel: Project -> Settings -> Environment Variables
# ============================================================

# --- Enquiry delivery by email (the main route) -------------
# Create a free account at resend.com, verify averan.eu, then paste the key.
# Until RESEND_API_KEY and CONTACT_EMAIL_FROM are both set, the contact form
# tells visitors it cannot send rather than silently losing their enquiry.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
CONTACT_EMAIL_FROM=Averan Website <website@averan.eu>
# Where enquiries land. Defaults to info@averan.eu when blank.
CONTACT_EMAIL_TO=info@averan.eu

# --- Optional second destination ----------------------------
# A webhook (Make, Zapier, n8n, your own endpoint) receives the same enquiry,
# for a CRM or a sheet. Must be HTTPS and reply {"accepted":true,"receiptId":"..."}.
# Email is what the site relies on: if the webhook fails, the sender is not
# asked to try again.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=

# --- Optional spam protection -------------------------------
# Cloudflare Turnstile, free. Enforced only when BOTH keys are set; the form's
# honeypot and size limits apply regardless.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Site -----------------------------------------------------
# Search engines are allowed by default. Vercel preview and development
# deployments are excluded automatically. Set SITE_NOINDEX=true only to
# deliberately keep the live site out of search results.
# If an old SITE_LIVE variable is still set in Vercel, it now does nothing and
# can be deleted.
SITE_NOINDEX=
# Only needed if the public origin differs from the request host.
SITE_ORIGIN=

LINKEDIN_URL=
FOUNDER_PHOTO_PATH=
