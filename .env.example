# Booking page for every "Request a Call" button (Google Calendar appointment schedule, Calendly or Cal.com).
# Without it, buttons open a pre-filled email to info@averan.eu.
NEXT_PUBLIC_BOOKING_URL=

# Optional. Leave empty to run with no cookies and no banner.
# Set either ID and a consent banner appears; Google tags load only after "Accept".
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Google Ads conversion action fired when a consenting visitor clicks "Request a Call", e.g. AW-123456789/AbCdEfGh
NEXT_PUBLIC_GOOGLE_ADS_CALL_CONVERSION=

# Enquiry form: a Make/Zapier webhook that emails each enquiry to info@averan.eu.
# Until it is set, the form opens a pre-filled email instead, so no enquiry is lost.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_TOKEN=

# Optional live demo: a Make/Zapier webhook that emails the visitor a fixed demo reply.
# The section stays hidden until this is set. Add hosting rate limits for /api/live-demo as well.
LIVE_DEMO_WEBHOOK_URL=
LIVE_DEMO_WEBHOOK_TOKEN=
SITE_ORIGIN=https://averan.eu

SITE_LIVE=false
LINKEDIN_URL=
