# ============================================================
#  Averan website configuration
#  Set these in Vercel: Project -> Settings -> Environment Variables
# ============================================================

# --- Enquiry form (Make webhook) ------------------------------
# A Make scenario that emails each enquiry to info@averan.eu. See MAKE-SETUP.md.
# Until it is set, the form opens a pre-filled email instead, so no enquiry is lost.
ENQUIRY_WEBHOOK_URL=
# The webhook's API key in Make; sent as the x-make-apikey header.
ENQUIRY_WEBHOOK_TOKEN=

# --- Live demo (Make webhook) ---------------------------------
# A Make scenario that emails the visitor a fixed demo reply.
# The section stays hidden until this is set. Add hosting rate limits for /api/live-demo as well.
LIVE_DEMO_WEBHOOK_URL=
LIVE_DEMO_WEBHOOK_TOKEN=

# --- Calls ----------------------------------------------------
# Booking page for every "Book a call" button (Google Calendar appointment schedule).
# Without it, buttons open a pre-filled email to info@averan.eu.
NEXT_PUBLIC_BOOKING_URL=

# --- Measurement (optional) -----------------------------------
# Leave empty to run with no cookies and no banner.
# Set either ID and a consent banner appears; Google tags load only after "Accept".
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Google Ads conversion fired when a consenting visitor books a call or sends an enquiry, e.g. AW-123456789/AbCdEfGh
NEXT_PUBLIC_GOOGLE_ADS_CALL_CONVERSION=

# --- Site -----------------------------------------------------
# Search engines are allowed by default. Vercel preview and development
# deployments are excluded automatically. Set SITE_NOINDEX=true only to
# deliberately keep the live site out of search results.
# If an old SITE_LIVE variable is still set in Vercel, it now does nothing and
# can be deleted.
SITE_NOINDEX=
# Used by the API routes' origin check.
SITE_ORIGIN=https://averan.eu
LINKEDIN_URL=
